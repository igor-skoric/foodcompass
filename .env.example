DJANGO_DEBUG=false
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=foodcompass.rs,www.foodcompass.rs
DJANGO_CSRF_TRUSTED_ORIGINS=https://foodcompass.rs,https://www.foodcompass.rs
DJANGO_SSL_REDIRECT=false
DJANGO_SERVE_MEDIA=true
SITE_URL=https://foodcompass.rs

# Kontakt forma — SMTP
# Lokalno, bez EMAIL_HOST, poruka ide u konzolu (runserver).
# Na serveru popuni host, nalog i lozinku.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=office@foodcompass.rs
# Google App Password: 16 slova, bez razmaka i bez navodnika.
EMAIL_HOST_PASSWORD=abcdefghijklmnop
EMAIL_FROM=Food Compass <office@foodcompass.rs>
# Više adresa odvojite zarezom. Ista poruka stiže na sve.
CONTACT_EMAIL=office@foodcompass.rs,druga@adresa.rs